{
  "name": "pubquiz-invoice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Swiss QR-Rechnung generator for Pub Quiz Bern",
  "scripts": {
    "build": "esbuild browser-app.mjs --bundle --format=esm --outfile=dist/browser.js --platform=browser --target=es2020",
    "generate": "node generate.mjs",
    "sample": "node generate.mjs --data examples/sample-invoice.json --out output/QR_Rechnung_20261111.pdf"
  },
  "dependencies": {
    "blob-stream": "^0.1.3",
    "pdfkit": "^0.20.2",
    "swissqrbill": "^4.4.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
